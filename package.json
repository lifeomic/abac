{
  "name": "@lifeomic/abac",
  "version": "0.0.0",
  "description": "LifeOmic Attribute Based Access Control Support Module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "browser": "src/browser.js",
  "module": "src/index.mjs",
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifeomic/abac.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "node": {
        "import": "./src/index.mjs",
        "require": "./src/index.js"
      },
      "browser": "./src/browser.js"
    },
    "./enforce-lenient": {
      "types": "./src/enforce-lenient.d.ts",
      "import": "./src/enforce-lenient.mjs",
      "require": "./src/enforce-lenient.js"
    },
    "./types": {
      "types": "./src/types.d.ts",
      "import": "./src/types.mjs",
      "require": "./src/types.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./src/types.d.ts"
      ],
      "enforce-lenient": [
        "./src/enforce-lenient.d.ts"
      ]
    }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.d.ts",
    "enforce-lenient/package.json",
    "types/package.json"
  ],
  "sideEffects": false,
  "author": "LifeOmic <development@lifeomic.com>",
  "license": "MIT",
  "scripts": {
    "clean": "./clean.sh",
    "build": "node esbuild.config.mts && node node_modules/typescript/bin/tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint --ext .ts,.cjs,.mjs src test scripts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit --project tsconfig.json",
    "pretest": "pnpm run lint && pnpm run typecheck",
    "test": "vitest run",
    "compat:check": "node scripts/compat/check-build.mjs"
  },
  "dependencies": {
    "deep-clone": "^3.0.3"
  },
  "devDependencies": {
    "@lifeomic/eslint-config-standards": "3.1.0",
    "@lifeomic/typescript-config": "^4.0.0",
    "@types/deep-equal": "^1.0.1",
    "@types/node": "^24",
    "@types/semver": "^7.5.0",
    "@vitest/coverage-v8": "^5.0.5",
    "abac-published": "npm:@lifeomic/abac@5.0.0",
    "ajv": "^8.12.0",
    "browserslist": "^4.21.5",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "deep-equal": "2.2.3",
    "esbuild": "^0.25.0",
    "esbuild-plugin-browserslist": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "glob": "^10.2.3",
    "prettier": "^2.7.1",
    "semantic-release": "^19.0.3",
    "semver": "^7.5.0",
    "typescript": "~5.9.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "ajv": ">=6.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.15.0"
}
